# Copy to .env (npm run setup does this) and adjust. Never commit .env.
# Variables prefixed VIBESTUDIO_ are server-side only.
# Only VITE_* variables are exposed to the browser bundle, so never put secrets in them.

# --- Backend (FastAPI) ---
VIBESTUDIO_ENV=development
VIBESTUDIO_LOG_LEVEL=INFO
# Default is SQLite at backend/data/vibestudio.db. For PostgreSQL (see docker-compose.yml):
# VIBESTUDIO_DATABASE_URL=postgresql+psycopg://vibestudio:vibestudio@localhost:5432/vibestudio
# JSON list of allowed browser origins (only needed when not using the Vite proxy):
# VIBESTUDIO_CORS_ORIGINS=["http://localhost:5173"]
VIBESTUDIO_MAX_PROJECT_BYTES=5242880
VIBESTUDIO_MAX_REVISIONS_PER_PROJECT=200
# Uploaded recordings. Stored immutably by content hash under this folder.
# VIBESTUDIO_ASSETS_DIR=backend/data/assets
VIBESTUDIO_MAX_UPLOAD_BYTES=26214400
VIBESTUDIO_MAX_UPLOAD_SECONDS=120

# --- Frontend dev server (Vite) ---
# Where the Vite dev proxy forwards /api requests. Read by vite.config.ts, not the browser.
VIBESTUDIO_BACKEND_URL=http://127.0.0.1:8000
# Optional absolute API origin for builds served without the proxy. Empty means same origin.
# VITE_API_BASE_URL=

# --- AI beat generator: optional LLM prompt interpreter ---
# "none" (default) reads prompts with offline keyword rules. "anthropic" asks Claude to
# read the prompt into generation settings; the music itself is always written by the
# procedural composer. Calls are billed to your Anthropic account.
VIBESTUDIO_LLM_PROVIDER=none
# VIBESTUDIO_LLM_MODEL=claude-opus-5-5
# VIBESTUDIO_LLM_TIMEOUT_SECONDS=30
# The Anthropic SDK reads its own credentials (server-side only, never a VITE_ variable):
# ANTHROPIC_API_KEY=
